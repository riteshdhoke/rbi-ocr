# Copy to .env and fill in. .env is gitignored — never commit tokens.

# --- Model endpoint -------------------------------------------------------
# HF_TOKEN is required ONLY when HF_BASE_URL is a public endpoint. An in-house
# vLLM / llama.cpp / Ollama / TGI server authenticates nothing, so leave the
# token unset on cpu_node and gpu_node.
HF_TOKEN=hf_your_token_here
HF_BASE_URL=https://router.huggingface.co/v1
# Extra hostnames to treat as on-premises, comma separated. Loopback, RFC1918
# literals, unqualified names and .internal/.local/.lan/.intranet are already
# recognised; use this only for an in-house server behind a public-looking
# FQDN, e.g. LOCAL_ENDPOINT_HOSTS=slm.rbi.gov.in
LOCAL_ENDPOINT_HOSTS=

PROVIDER_PROFILE=laptop            # laptop | cpu_node | gpu_node
SYNTHETIC_ONLY=true                # MUST stay true under laptop profile
# On gpu_node, if you point HF_BASE_URL anywhere it must be an on-premises
# host: the profile asserts the deployment is air-gapped, so an off-premises
# endpoint is refused at startup rather than silently sending complainant text
# off site. Leaving the default above means "no model server on this box" —
# the node starts, never opens the socket, and extracts fields with the
# deterministic validators only. cpu_node never reads this value at all.

# --- GPU ------------------------------------------------------------------
# auto    = CUDA only on gpu_node, and only if the runtime exposes it
# require = refuse to start without a GPU (use this on a real GPU node, so a
#           CPU-only onnxruntime wheel is a loud failure, not a silent 10x
#           slowdown)
# never   = pin CPU everywhere
# `require`/gpu_node also needs: pip install onnxruntime-gpu (and uninstall the
# CPU-only onnxruntime wheel — they collide).
GPU_EXECUTION=auto
SLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
SLM_MODEL_FALLBACK=google/gemma-3-4b-it
SLM_MAX_TOKENS=512
SLM_TEMPERATURE=0
JOB_TOKEN_BUDGET=8000
PROVIDER_CACHE_PATH=.cache/provider.sqlite

OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
ORT_INTRA_OP_THREADS=2

OCR_BATCH_SIZE=4
REC_HEAD_CACHE_SIZE=3
ESCALATION_SHADOW_RATE=0.03
QUALITY_BOUNCE_THRESHOLD=0.35
MAX_PAGES_PER_DOC=200
MAX_DECOMPRESSION_RATIO=100

# --- Reference tables -----------------------------------------------------
# These are two DIFFERENT files and one does not stand in for the other.
# IFSC_MASTER_PATH resolves branch codes; point it at the real RBI list on a
# production node (a .csv loads as authoritative). BANK_ALIASES_PATH resolves
# bank *names* — the spellings, acronyms and Devanagari renderings an OCR'd
# complaint actually carries, plus the institutions that are never the bank
# complained about (the RBI itself is the addressee of every complaint). The
# committed table already covers the banking system; override it only to add
# regional co-operatives or RRBs.
IFSC_MASTER_PATH=app/resources/ifsc_master_sample.json
BANK_ALIASES_PATH=app/resources/bank_aliases.json

# --- Categorisation -------------------------------------------------------
# The shipped categoriser is a PLACEHOLDER keyword matcher over an invented
# taxonomy; the real RB-IOS list does not exist here yet. Startup warns about
# it every time. Set this true once a real classifier is installed, so a
# rollback to the stub refuses to start instead of shipping placeholder tags.
REQUIRE_PRODUCTION_CATEGORISER=false

# Discover any labeled OCR fields and allow open-vocabulary model extraction.
# false restores the legacy fixed field selection. No network is added by this.
EXTRACT_ALL_FIELDS=true
