{% extends "hin/_layout.txt.j2" %}
{#- BLUR_ABOVE_CEILING - quality gate: variance of Laplacian below the sharpness floor -#}
{% block subject %}दस्तावेज़ की लिखावट धुँधली है और पढ़ी नहीं जा सकती{% endblock %}
{% block defect %}पृष्ठों की लिखावट फ़ोकस से बाहर है। अलग-अलग अक्षर एक-दूसरे से अलग नहीं किए जा
सकते, इसलिए कुछ भी भरोसे के साथ नहीं पढ़ा जा सका — और अनुमान से लिखी गई खाता
संख्या आपके लिए कुछ न होने से भी अधिक हानिकारक होती।{% endblock %}
{% block remedy %}कृपया दस्तावेज़ को {{ recommended_dpi }} DPI पर दोबारा स्कैन करें। यदि आप
फ़ोन का उपयोग कर रहे हैं, तो कोहनियाँ मेज़ पर टिकाइए, स्क्रीन पर लिखावट को छूकर
कैमरे का फ़ोकस उस पर लाइए, और दिन के उजाले या तेज़ रोशनी में चित्र लीजिए।{% endblock %}
