{% extends "hin/_layout.txt.j2" %}
{#- PAGE_CAP_EXCEEDED - ingestion: more pages than MAX_PAGES_PER_DOC -#}
{% block subject %}आपके दस्तावेज़ में एक बार में स्वीकार्य पृष्ठों से अधिक पृष्ठ हैं{% endblock %}
{% block defect %}आपके भेजे दस्तावेज़ में {{ max_pages }} से अधिक पृष्ठ हैं, जबकि एक संलग्नक
में हम इतने ही पृष्ठ संसाधित कर सकते हैं।{% endblock %}
{% block remedy %}कृपया केवल वे पृष्ठ भेजें जो आपकी शिकायत से संबंधित हैं — प्रायः शिकायत
पत्र, बैंक का उत्तर, और वह विवरण या रसीद जिसमें विवादित प्रविष्टि दिखती है।
यदि पूरा दस्तावेज़ भेजना आवश्यक हो, तो उसे {{ max_pages }} से कम पृष्ठों वाले
कई संलग्नकों में बाँटकर अलग-अलग संदेशों में भेजें और हर संदेश में नीचे दी गई
संदर्भ संख्या लिखें।{% endblock %}
